name: Build iOS (IPA sem assinatura)
on:
  workflow_dispatch:
jobs:
  build:
    runs-on: macos-latest
    defaults:
      run:
        working-directory: ios
    steps:
      - uses: actions/checkout@v4
      - name: Gerar projeto Xcode
        run: brew install xcodegen && xcodegen generate
      - name: Compilar
        run: >
          xcodebuild -project WolfIOS.xcodeproj -scheme WolfIOS
          -sdk iphoneos -configuration Release -derivedDataPath build
          CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY=""
      - name: Empacotar IPA
        run: |
          mkdir Payload
          cp -r build/Build/Products/Release-iphoneos/WolfIOS.app Payload/
          zip -r WolfIOS.ipa Payload
      - uses: actions/upload-artifact@v4
        with:
          name: WolfIOS-ipa
          path: ios/WolfIOS.ipa
