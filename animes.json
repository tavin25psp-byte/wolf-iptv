<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>WOLF IPTV - Animes</title>

<style>
* {
    box-sizing: border-box;
}

body {
    margin: 0;
    background: #080808;
    color: white;
    font-family: Arial, sans-serif;
}

header {
    padding: 20px;
    background: #151515;
    border-bottom: 3px solid #e50914;
}

header h1 {
    color: #e50914;
    margin: 0;
}

header p {
    color: #aaa;
    margin-bottom: 0;
}

main {
    padding: 18px;
}

#pesquisa {
    width: 100%;
    padding: 14px;
    margin-bottom: 15px;
    border: 1px solid #333;
    border-radius: 8px;
    background: #191919;
    color: white;
    font-size: 16px;
}

#status {
    color: #bbb;
}

.grade {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
}

.card {
    background: #191919;
    border-radius: 8px;
    overflow: hidden;
    cursor: pointer;
    border: 1px solid #292929;
}

.card:focus {
    outline: 2px solid #e50914;
}

.card img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    display: block;
    background: #222;
}

.card h3 {
    font-size: 13px;
    padding: 8px;
    margin: 0;
    overflow-wrap: anywhere;
}

.card p {
    font-size: 11px;
    color: #aaa;
    padding: 0 8px 8px;
    margin: 0;
}

#playerArea {
    display: none;
    margin-bottom: 20px;
    background: #151515;
    padding: 12px;
    border-radius: 8px;
}

#fechar {
    background: #e50914;
    color: white;
    border: 0;
    border-radius: 5px;
    padding: 10px 15px;
    margin-bottom: 10px;
}

video {
    width: 100%;
    max-height: 65vh;
    background: black;
}

@media (min-width: 700px) {
    .grade {
        grid-template-columns: repeat(5, minmax(0, 1fr));
    }
}

@media (min-width: 1100px) {
    .grade {
        grid-template-columns: repeat(6, minmax(0, 1fr));
    }
}
</style>
</head>

<body>

<header>
    <h1>🐺 WOLF IPTV</h1>
    <p>Filmes, séries e animes</p>
</header>

<main>
    <h2>🔥 Animes</h2>

    <input
        id="pesquisa"
        type="search"
        placeholder="Pesquisar anime ou episódio..."
    >

    <p id="status">Carregando anime.json...</p>

    <section id="playerArea">
        <button id="fechar">✖ Fechar</button>
        <h3 id="tituloPlayer"></h3>
        <video id="video" controls playsinline></video>
        <p id="erroVideo"></p>
    </section>

    <div id="grade" class="grade"></div>
</main>

<script>
const URL_JSON =
    "https://raw.githubusercontent.com/tavin25psp-byte/wolf-iptv/main/anime.json";

const grade = document.getElementById("grade");
const status = document.getElementById("status");
const pesquisa = document.getElementById("pesquisa");
const playerArea = document.getElementById("playerArea");
const video = document.getElementById("video");

let animes = [];

function obterCampo(obj, campos) {
    for (const campo of campos) {
        if (
            obj &&
            obj[campo] !== undefined &&
            obj[campo] !== null &&
            obj[campo] !== ""
        ) {
            return obj[campo];
        }
    }

    return "";
}

function transformarItem(item) {
    return {
        titulo: String(obterCampo(item, [
            "name", "title", "titulo", "nome"
        ]) || "Anime sem título"),

        capa: String(obterCampo(item, [
            "cover", "image", "poster", "logo",
            "tvg-logo", "thumbnail", "thumb", "capa"
        ])),

        url: String(obterCampo(item, [
            "url", "link", "stream_url", "file",
            "episode_url"
        ])),

        categoria: String(obterCampo(item, [
            "group", "category", "categoria", "group-title"
        ]))
    };
}

function obterLista(dados) {
    if (Array.isArray(dados)) {
        return dados;
    }

    if (dados && Array.isArray(dados.animes)) {
        return dados.animes;
    }

    if (dados && Array.isArray(dados.items)) {
        return dados.items;
    }

    if (dados && Array.isArray(dados.channels)) {
        return dados.channels;
    }

    if (dados && Array.isArray(dados.results)) {
        return dados.results;
    }

    return [];
}

function criarCard(item) {
    const card = document.createElement("article");
    card.className = "card";
    card.tabIndex = 0;

    const img = document.createElement("img");
    img.loading = "lazy";
    img.alt = item.titulo;

    if (item.capa) {
        img.src = item.capa;
    } else {
        img.src = gerarCapa(item.titulo);
    }

    img.onerror = () => {
        img.onerror = null;
        img.src = gerarCapa("WOLF IPTV");
    };

    const titulo = document.createElement("h3");
    titulo.textContent = item.titulo;

    const categoria = document.createElement("p");
    categoria.textContent = item.categoria || "Anime";

    card.append(img, titulo, categoria);

    function abrir() {
        if (!item.url) {
            alert("Não foi encontrado um link de reprodução para este item.");
            return;
        }

        document.getElementById("tituloPlayer").textContent =
            item.titulo;

        document.getElementById("erroVideo").textContent = "";
        playerArea.style.display = "block";

        video.pause();
        video.removeAttribute("src");
        video.load();

        video.src = item.url;
        video.load();

        playerArea.scrollIntoView({ behavior: "smooth" });

        video.play().catch(() => {
            document.getElementById("erroVideo").textContent =
                "Toque em Play. Se não funcionar, o formato pode não ser compatível com o player.";
        });
    }

    card.addEventListener("click", abrir);

    card.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            abrir();
        }
    });

    return card;
}

function gerarCapa(texto) {
    const svg = `
        <svg xmlns="http://www.w3.org/2000/svg"
             width="300" height="450">
            <rect width="100%" height="100%" fill="#191919"/>
            <text x="50%" y="45%"
                  fill="#e50914"
                  text-anchor="middle"
                  font-size="30"
                  font-weight="bold">WOLF</text>
            <text x="50%" y="55%"
                  fill="white"
                  text-anchor="middle"
                  font-size="18">${texto}</text>
        </svg>
    `;

    return "data:image/svg+xml;charset=UTF-8," +
        encodeURIComponent(svg);
}

function renderizar() {
    const termo = pesquisa.value.trim().toLowerCase();

    const filtrados = animes.filter(item =>
        item.titulo.toLowerCase().includes(termo) ||
        item.categoria.toLowerCase().includes(termo)
    );

    grade.replaceChildren();

    const fragmento = document.createDocumentFragment();

    filtrados.forEach(item => {
        fragmento.appendChild(criarCard(item));
    });

    grade.appendChild(fragmento);

    status.textContent = filtrados.length
        ? filtrados.length + " itens encontrados"
        : "Nenhum anime encontrado.";
}

async function carregarAnimes() {
    try {
        const resposta = await fetch(URL_JSON + "?v=" + Date.now());

        if (!resposta.ok) {
            throw new Error("Erro HTTP " + resposta.status);
        }

        const dados = await resposta.json();

        animes = obterLista(dados).map(transformarItem);

        if (!animes.length) {
            throw new Error(
                "O formato de anime.json não foi reconhecido."
            );
        }

        renderizar();

    } catch (erro) {
        console.error("Erro ao carregar anime.json:", erro);

        status.textContent =
            "Erro ao carregar anime.json. Confira o nome, o caminho e o formato do arquivo no GitHub.";
    }
}

pesquisa.addEventListener("input", renderizar);

document.getElementById("fechar").addEventListener("click", () => {
    video.pause();
    video.removeAttribute("src");
    video.load();
    playerArea.style.display = "none";
});

carregarAnimes();
</script>

</body>
</html>
